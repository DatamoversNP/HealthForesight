# =============================================================================
# Copy to production.azure.env and fill in real values (never commit that file).
#   cp scripts/azure/production.azure.env.example scripts/azure/production.azure.env
#
# Terminal tips:
#   - Lines starting with # are comments — do not paste them as commands (zsh: command not found: #).
#   - Run only:  PRODUCTION_ENV_FILE=scripts/azure/production.azure.env ./scripts/azure/deploy-production-stack.sh
# =============================================================================

# --- Required (replace entire values; no placeholders) ---
# PostgreSQL: Azure Portal → your server → Connection strings → ADO.NET or JDBC and adapt to:
#   postgresql://USER@SERVER:PASSWORD@SERVER.postgres.database.azure.com:5432/DBNAME?sslmode=require
# (Flexible Server often uses USER format user@servername — URL-encode special chars in password.)
DATABASE_URL=

# Redis: Portal → Azure Cache for Redis → Access keys → copy connection string, or build:
#   rediss://:PRIMARY_ACCESS_KEY@YOUR_CACHE_NAME.redis.cache.windows.net:6380/0
REDIS_URL=

# --- API security ---
JWT_SECRET=

# --- Optional: Blob / object storage ---
# OBJECT_STORAGE_ENDPOINT=https://YOURACCOUNT.blob.core.windows.net
# OBJECT_STORAGE_ACCESS_KEY=
# OBJECT_STORAGE_SECRET_KEY=
# OBJECT_STORAGE_BUCKET=uepi-data

# --- Optional overrides ---
# RESOURCE_GROUP=healthforesight-rg
# API_APP_NAME=healthforesight-api
# WORKER_APP_NAME=healthforesight-worker
# ACR_NAME=healthforesightacr
# STATIC_WEB_APP_NAME=healthforesight-web
