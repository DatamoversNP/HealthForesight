# Database Configuration Template for LOCAL Development
# Copy this file to .env and update with your actual local PostgreSQL credentials

# Option 1: Local PostgreSQL (most common)
# If you installed PostgreSQL locally (Homebrew, apt, etc.)
# Default user is usually 'postgres' or your system username
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/uepi_db

# Option 2: Docker Compose (if using docker-compose.yml)
# Uncomment this if you're running PostgreSQL via Docker Compose
# DATABASE_URL=postgresql://uepi:uepi123@localhost:5432/uepi

# Option 3: Homebrew PostgreSQL on macOS
# If you installed PostgreSQL via Homebrew, user might be your system username
# DATABASE_URL=postgresql://$(whoami)@localhost:5432/uepi_db

# Connection pool settings (optional - defaults are fine)
# DATABASE_POOL_SIZE=10
# DATABASE_MAX_OVERFLOW=20
# DATABASE_ECHO=false

# To find your local PostgreSQL setup:
# 1. Check if PostgreSQL is running: ps aux | grep postgres
# 2. Check what databases exist: psql -l
# 3. Check what user you can connect as: psql -U postgres -l
# 4. Create database if needed: createdb uepi_db
