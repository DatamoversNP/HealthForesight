{
  "name": "uepi-web",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:docs": "vite --config vite.docs.config.ts",
    "dev:marketing": "vite --config vite.marketing.config.ts",
    "build": "tsc && vite build",
    "build:skip-check": "vite build",
    "build:marketing": "vite build --config vite.marketing.config.ts && node -e \"const fs=require('fs');const p='dist-marketing/index-marketing.html';if(fs.existsSync(p)){fs.renameSync(p,'dist-marketing/index.html');console.log('✓ Renamed to index.html');}\"",
    "preview": "vite preview",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "test": "vitest",
    "format": "prettier --write \"src/**/*.{ts,tsx,json,css}\"",
    "capture-screenshots": "node scripts/capture-tour-screenshots-playwright.js",
    "test-tour-targeting": "node scripts/verify-tour-targeting.js"
  },
  "dependencies": {
    "@emotion/react": "^11.11.1",
    "@emotion/styled": "^11.11.0",
    "@mui/icons-material": "^5.14.19",
    "@mui/material": "^5.14.20",
    "@mui/x-date-pickers": "^6.19.0",
    "@types/react-joyride": "^2.0.2",
    "axios": "^1.6.2",
    "date-fns": "^2.30.0",
    "gsap": "^3.14.2",
    "playwright": "^1.58.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-joyride": "^2.9.3",
    "react-router-dom": "^6.20.0",
    "recharts": "^2.10.3",
    "socket.io-client": "^4.6.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@typescript-eslint/eslint-plugin": "^6.14.0",
    "@typescript-eslint/parser": "^6.14.0",
    "@vitejs/plugin-react": "^4.2.1",
    "eslint": "^8.55.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "jsdom": "^27.4.0",
    "prettier": "^3.1.0",
    "typescript": "^5.2.2",
    "vite": "^5.0.8",
    "vitest": "^1.0.4"
  }
}
